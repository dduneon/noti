# 텔레그램 봇 토큰 (@BotFather 에서 발급)
NOTI_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# 알림 받을 chat id (@userinfobot 에게 말 걸면 알려줌, 그룹이면 음수)
NOTI_TELEGRAM_CHAT_ID=123456789

# 폴링 주기(초). 너무 짧게 두지 말 것 (기본 300초)
NOTI_POLL_INTERVAL_SECONDS=300

# 아래는 보통 건드릴 필요가 없습니다.
# 도커에서는 compose 가 컨테이너 경로(/config, /data)를 지정하므로
# 여기에 경로를 적으면 그 설정을 덮어써서 컨테이너가 엉뚱한 경로를 봅니다.
# 직접(venv) 실행할 때만 필요하면 주석을 푸세요.
#NOTI_CONFIG_PATH=config.yaml
#NOTI_DB_PATH=noti.db
